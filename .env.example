# Copier ce fichier en .env.local

# Clé API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optionnel : dossier des données locales (profils, équipe, guides, plans, cache). Défaut : ./data
# DATA_DIR=

# Optionnel : secret de signature des sessions. Sinon généré automatiquement dans data/session-secret.key
# SESSION_SECRET=

# Mettre à true si l'app est servie en HTTPS (reverse proxy) : le cookie de session sera "Secure"
# COOKIE_SECURE=false
